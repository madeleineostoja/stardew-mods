{
  "$schema": "https://smapi.io/schemas/content-patcher.json",
  "Format": "2.9.0",
  "ConfigSchema": {
    "BoxSize": {
      "AllowValues": "Compact, Normal",
      "Default": "Compact"
    },
    "PortraitSize": {
      "AllowValues": "Small, Medium, Large",
      "Default": "Medium"
    },
    "PortraitAlignment": {
      "AllowValues": "Left, Right",
      "Default": "Left"
    },
    "NameplateAlignment": {
      "AllowValues": "Left, Right",
      "Default": "Left"
    }
  },
  "DynamicTokens": [
    {
      "Name": "NameplateXOffset",
      "Value": "48"
    },
    {
      "Name": "NameplateXOffset",
      "Value": "-48",
      "When": {
        "NameplateAlignment": "Right"
      }
    },
    {
      "Name": "NameplateTextAlignment",
      "Value": "0"
    },
    {
      "Name": "NameplateTextAlignment",
      "Value": "2",
      "When": {
        "NameplateAlignment": "Right"
      }
    },
    {
      "Name": "BoxWidth",
      "Value": "1088"
    },
    {
      "Name": "BoxWidth",
      "Value": "1200",
      "When": {
        "BoxSize": "Normal"
      }
    },
    {
      "Name": "BoxHeight",
      "Value": "320"
    },
    {
      "Name": "BoxHeight",
      "Value": "384",
      "When": {
        "BoxSize": "Normal"
      }
    },
    {
      "Name": "ResolvedPortraitScale",
      "Value": "5"
    },
    {
      "Name": "ResolvedPortraitScale",
      "Value": "4",
      "When": {
        "PortraitSize": "Small"
      }
    },
    {
      "Name": "ResolvedPortraitScale",
      "Value": "6",
      "When": {
        "PortraitSize": "Large"
      }
    },
    {
      "Name": "PortraitXOffset",
      "Value": "24"
    },
    {
      "Name": "PortraitXOffset",
      "Value": "{{Round: {{Query: 0 - 24 - (64 * {{ResolvedPortraitScale}}) }} }}",
      "When": {
        "PortraitAlignment": "Right"
      }
    }
  ],
  "Changes": [
    {
      "Action": "EditData",
      "Target": "aedenthorn.DialogueDisplayFramework/dictionary",
      "Entries": {
        "default": {
          "packName": "heyitsmads.ImmersiveDialogueUI",
          "xOffset": "{{Round: {{Query: (1200 - {{BoxWidth}}) / 2 }} }}",
          "yOffset": "{{Round: {{Query: 384 - {{BoxHeight}} }} }}",
          "width": "{{BoxWidth}}",
          "height": "{{BoxHeight}}",
          "dialogue": {
            "xOffset": 32,
            "yOffset": 40,
            "width": "{{Round: {{Query: {{BoxWidth}} - 64 }} }}",
            "alignment": 0,
            "layerDepth": 0.88
          },
          "portrait": {
            "xOffset": "{{PortraitXOffset}}",
            "yOffset": "{{Round: {{Query: 0 - 16 - (64 * {{ResolvedPortraitScale}}) }} }}",
            "right": "{{PortraitAlignment |contains=Right}}",
            "w": 64,
            "h": 64,
            "scale": "{{ResolvedPortraitScale}}",
            "layerDepth": 0.89
          },
          "name": {
            "xOffset": "{{NameplateXOffset}}",
            "yOffset": -48,
            "right": "{{NameplateAlignment |contains=Right}}",
            "scrollType": 0,
            "alignment": "{{NameplateTextAlignment}}",
            "layerDepth": 0.9
          },
          "button": {
            "xOffset": -52,
            "yOffset": -56,
            "right": true,
            "bottom": true,
            "layerDepth": 0.9
          },
          "jewel": {
            "disabled": true
          },
          "gifts": {
            "disabled": true
          },
          "hearts": {
            "disabled": true
          },
          "images": [],
          "texts": [],
          "dividers": [],
          "disabled": false
        }
      }
    }
  ]
}
